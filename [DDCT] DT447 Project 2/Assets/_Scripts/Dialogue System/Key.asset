  m_Script: {fileID: 11500000, guid: 8b80b44c40c687e44a07621c361d39ab, type: 3}
  m_Name: Key
  m_EditorClassIdentifier: 
  lines:
  - name: ...
    portrait: {fileID: 0}
    text: ...
  - name: ...
    portrait: {fileID: 0}
    text: (The sight of the headstone before you lefts you speachless.)
  - name: ...
    portrait: {fileID: 0}
    text: (The weathered groves etched on it form a strage yet familiar name.)
  - name: ...
    portrait: {fileID: 0}
    text: (No. This is no gravestone... this is but a cenotaph.)
  - name: ...
    portrait: {fileID: 0}
    text: (There is no body lies beneath the stone.)
  - name: ...
    portrait: {fileID: 0}
    text: (You remeber a face of a man, pround and strong. He left home with puffed
      chest and a face don with confidence.)
  - name: ...
    portrait: {fileID: 0}
    text: (Everyone from the village waved their hands to see him off, hoping he
      would come back with fame and glory.)
  - name: ...
    portrait: {fileID: 0}
    text: (But there is no glory in dying on the battlefield.)
  - name: ...
    portrait: {fileID: 0}
    text: (And no amount of cries would be enough to wake the death.)
  - name: ...
    portrait: {fileID: 0}
    text: (...)
  - name: ...
    portrait: {fileID: 0}
    text: (A rusty key is slapped on the face of the stone.)
  - name: ...
    portrait: {fileID: 0}
    text: (You picked it up.)
