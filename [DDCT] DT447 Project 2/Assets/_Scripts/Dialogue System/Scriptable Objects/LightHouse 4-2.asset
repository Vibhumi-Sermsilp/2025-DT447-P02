  m_Script: {fileID: 11500000, guid: 8b80b44c40c687e44a07621c361d39ab, type: 3}
  m_Name: LightHouse 4-2
  m_EditorClassIdentifier: 
  lines:
  - name: ...
    portrait: {fileID: 0}
    text: (The machine hums to life, casting light to the final destination.)
  - name: ...
    portrait: {fileID: 0}
    text: (...)
  - name: ...
    portrait: {fileID: 0}
    text: (Yes, that is no longer matter.)
  - name: ...
    portrait: {fileID: 0}
    text: (Whether it's right or wrong, it is the choice that you have made yourself.)
  - name: ...
    portrait: {fileID: 0}
    text: (You have been avoiding facing them for so long, haven't you?)
  - name: ...
    portrait: {fileID: 0}
    text: (The choices you made.)
  - name: ...
    portrait: {fileID: 0}
    text: (The choice to ignore, the choice left things behind.)
  - name: ...
    portrait: {fileID: 0}
    text: (It all comes to haunt you once again, all of them.)
  - name: ...
    portrait: {fileID: 0}
    text: (This time you refuse to look away and address them properly.)
  - name: ...
    portrait: {fileID: 0}
    text: (Keep your eyes up, face them head on.)
  - name: ...
    portrait: {fileID: 0}
    text: (Only then you will be able to move on.)
